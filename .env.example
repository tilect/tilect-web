# Design panel on the home aurora (local / TEST only; leave unset in production).
# When "true", a brush button next to the theme toggle opens the design drawer.
SHOW_DESIGN_PANEL=

# T-shirt pre-order pages: 404 + out of the sitemap unless "true".
SHIRTS_ENABLED=

# Google Sheets (t-shirt pre-orders)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
